      "css": ".ds-rail{width:64px;padding:12px 0;background:var(--surface,#101313);border-right:1px solid var(--border,#2a3030);display:flex;justify-content:center;}.ds-nav-item{display:flex;align-items:center;justify-content:center;width:44px;height:43px;color:var(--quiet,#8e9993);position:relative;border-radius:6px;text-decoration:none;transition:background .15s,border-color .15s,color .15s;}.ds-nav-item:hover{background:var(--raised,#1b2020);color:var(--text,#eef2f0);}.ds-nav-item.ds-current{color:var(--accent,#83cfb3);}.ds-nav-item.ds-current:after{content:\"\";position:absolute;right:-10px;top:10px;bottom:10px;width:1px;background:var(--accent,#83cfb3);}.ds-nav-item:focus-visible{outline:2px solid var(--accent,#83cfb3);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-text,.ds-search,.ds-nav-item,.ds-finding-row{transition:none;}}"
