      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><div><h2>Analysis coverage</h2><p>Evidence you can trace to its source.</p></div></div></section>",
      "css": ".ds-panel{font-family:var(--font-sans,\"Public Sans\",sans-serif);background:var(--surface,#101313);color:var(--text,#eef2f0);border:1px solid var(--border,#2a3030);border-radius:var(--radius,10px);overflow:hidden;}.ds-panel-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:19px 20px;}.ds-panel-heading h2{font-size:14px;font-weight:500;line-height:1.4;margin:0;}.ds-panel-heading p{font-size:11px;line-height:1.55;margin:4px 0 0;color:var(--quiet,#8e9993);}"
