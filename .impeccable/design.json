      "refersTo": "finding-row",
      "description": "A compact evidence-bearing result with exact source location.",
      "html": "<button class=\"ds-finding-row\" type=\"button\"><span class=\"ds-finding-identity\"><strong>Shell command injection</strong><span class=\"ds-code-meta\">api/payments.py:15</span></span><span class=\"ds-row-severity\"><span aria-hidden=\"true\"></span>High</span><span class=\"ds-row-evidence\">Bandit<small>CWE-78</small></span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>",
      "css": ".ds-finding-row{font-family:var(--font-sans,\"Public Sans\",sans-serif);display:grid;grid-template-columns:minmax(0,1fr) 82px 116px 16px;align-items:center;gap:16px;padding:15px 20px;width:100%;text-align:left;border:0;border-bottom:1px solid var(--rule,#242a29);min-height:71px;background:var(--surface,#101313);color:var(--text,#eef2f0);cursor:pointer;transition:background .15s,border-color .15s,color .15s;}.ds-finding-row:hover{background:var(--raised,#1b2020);}.ds-finding-row:focus-visible{outline:2px solid var(--accent,#83cfb3);outline-offset:4px;}.ds-finding-identity{display:flex;flex-direction:column;gap:4px;min-width:0;}.ds-finding-identity strong{font-size:12px;font-weight:500;}.ds-code-meta{font-family:var(--font-mono,\"IBM Plex Mono\",monospace);font-size:11px;color:var(--quiet,#8e9993);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.ds-row-severity{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:400;line-height:20px;padding:0 7px;border-radius:4px;width:max-content;background:var(--red-wash,#302222);color:var(--high,#f09291);}.ds-row-severity>span{width:4px;height:4px;border-radius:50%;background:currentColor;}.ds-row-evidence{display:flex;flex-direction:column;gap:4px;font-size:11px;color:var(--muted,#a0aaa5);}.ds-row-evidence small{font-family:var(--font-mono,\"IBM Plex Mono\",monospace);font-size:11px;color:var(--quiet,#8e9993);}.ds-finding-row>svg{color:var(--quiet,#8e9993);}@media(max-width:760px){.ds-finding-row{grid-template-columns:minmax(0,1fr) 75px 16px;gap:8px;padding:14px 16px;}.ds-row-evidence{display:none;}.ds-finding-identity strong{font-size:11px;}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-text,.ds-search,.ds-nav-item,.ds-finding-row{transition:none;}}"
    }
