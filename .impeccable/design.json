  "narrative": {
    "northStar": "Data terminal",
    "overview": "CodeGuardian AI is a compact, professional review workspace. Obsidian surfaces, a sage action color, and a steady text hierarchy keep findings, source locations, and evidence legible during sustained review. The established direction is the “Data terminal” recorded in `.taste-skill/direction.json`; the implemented system is the visual authority for this extraction.\n\nPublic Sans carries interface language while IBM Plex Mono aligns counts, paths, identifiers, and source evidence. The requested liquid-glass character appears in sticky chrome and the import dialog. Working panels remain opaque, and the dark and light themes preserve the same hierarchy and component geometry.",
    "keyCharacteristics": [
      "Dense, task-focused layouts with clear reading order.",
      "Quiet neutral structure with sage actions and semantic severity colors.",
      "One-pixel selection edges on navigation, tabs, and the finding inbox.",
      "Restrained glass chrome around opaque evidence surfaces.",
      "Responsive review composition with labeled bottom navigation on phones."
    ],
    "rules": [
      {
        "name": "Selection Edge",
        "body": "Use the established one-pixel sage edge for active navigation, source tabs, and selected findings. Theme choices use an outlined selected state.",
        "section": "colors"
      },
      {
        "name": "Evidence Type",
        "body": "Use the sans face for reading and actions; use the mono face for counts, paths, code, rule identifiers, and snapshot metadata.",
        "section": "typography"
      },
      {
        "name": "Glass on Chrome",
        "body": "Reserve translucent blur for the top bar, phone navigation, dialog, and dialog backdrop. Keep source, evidence, and result panels opaque.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve semantic token roles in both themes; light mode changes palette, not hierarchy.",
      "Do pair severity color with readable severity text, and retain evidence labels beside findings.",
      "Do use mono numerals and metadata where comparison and exact identification matter.",
      "Do keep the visible focus treatment, reduced-motion behavior, and labeled phone navigation.",
      "Do keep chart axes, snapshot labels, and data context visible.",
      "Do use opaque working surfaces and restrained translucent chrome."
    ],
    "donts": [
      "Don't replace the selection edge with filled pill tabs.",
      "Don't turn ordinary counts or metadata into a wall of status color.",
      "Don't add glow, ambient panel shadows, or blurred backgrounds behind source evidence.",
      "Don't shrink the established small text to fit additional columns; use the responsive column reductions.",
      "Don't treat illustrative tonal ramps in the sidecar as new application palette tokens."
    ]
  }
}
