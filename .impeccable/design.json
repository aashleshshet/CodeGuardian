  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main available action; theme follows the host page.",
      "html": "<button class=\"ds-primary\" type=\"button\">Run scan</button>",
      "css": ".ds-primary{font-family:var(--font-sans,\"Public Sans\",sans-serif);height:35px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 13px;border-radius:6px;font-size:12px;font-weight:500;white-space:nowrap;cursor:pointer;transition:background .15s,border-color .15s,color .15s;background:var(--accent,#83cfb3);border:1px solid var(--accent,#83cfb3);color:#11291f;}.ds-primary:hover:not(:disabled){filter:brightness(1.08);}.ds-primary:focus-visible{outline:2px solid var(--accent,#83cfb3);outline-offset:4px;}.ds-primary:disabled{opacity:.55;cursor:not-allowed;}:host-context([data-theme=\"light\"]) .ds-primary{color:#fff;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-text,.ds-search,.ds-nav-item,.ds-finding-row{transition:none;}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "An outlined supporting action.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Export report</button>",
      "css": ".ds-secondary{font-family:var(--font-sans,\"Public Sans\",sans-serif);height:35px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 13px;border-radius:6px;font-size:12px;font-weight:500;white-space:nowrap;cursor:pointer;transition:background .15s,border-color .15s,color .15s;background:var(--surface,#101313);border:1px solid var(--control,#3c4542);color:var(--text,#eef2f0);}.ds-secondary:hover:not(:disabled){background:var(--hover,#222929);border-color:var(--quiet,#8e9993);}.ds-secondary:focus-visible{outline:2px solid var(--accent,#83cfb3);outline-offset:4px;}.ds-secondary:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-text,.ds-search,.ds-nav-item,.ds-finding-row{transition:none;}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "A quiet contextual action.",
      "html": "<button class=\"ds-text\" type=\"button\">Review all <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
