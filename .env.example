# Copy to .env; never commit populated credentials. See docs/deployment.md.
ENVIRONMENT=development
PUBLIC_URL=http://localhost:3000
DATABASE_URL=sqlite:///./codeguardian.db
REDIS_URL=redis://localhost:6379/0
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
SCANNER_MODE=docker
SCANNER_IMAGE=codeguardian-scanner:local
ENABLED_SCANNERS=semgrep,bandit,gitleaks,osv,trivy
SCAN_TIMEOUT=480
# Existing absolute paths on a DEDICATED scanner Docker host; worker mounts same paths.
SCANNER_JOBS_DIR=
SCANNER_CACHE_DIR=
# SCAN_ROOT/SCANNER_CACHE are set by Compose; set explicitly for a native worker.
SCAN_ROOT=
SCANNER_CACHE=
WORKER_UID=1000
# Use 1 for a small host; each scanner can consume up to 3 GiB in addition to services.
WORKER_CONCURRENCY=2
DOCKER_GID=1000
DOCKER_SOCKET=/var/run/docker.sock
TASKS_EAGER=false
MAX_SCAN_ATTEMPTS=3
WORKER_STALE_SECONDS=600
SOURCE_RETENTION_HOURS=24
RESULT_RETENTION_DAYS=90
ADVISORY_CACHE_HOURS=24
NVD_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
# PEM encoded with escaped newlines, or set via the deployment secret store.
GITHUB_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_CHECKS_ENABLED=false
LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=
# Remote source sharing is an explicit operator choice, not a default.
LLM_ALLOW_REMOTE=false
# Next.js server-only environment variable (also set in Vercel).
API_URL=http://127.0.0.1:8000
