# Copy to .env. Never commit the populated file.
ENVIRONMENT=development
PUBLIC_URL=http://localhost:3000
DATABASE_URL=sqlite:///./codeguardian.db
REDIS_URL=redis://localhost:6379/0
# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
# Generate locally: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
SCANNER_MODE=docker
SCANNER_IMAGE=codeguardian-scanner:local
# Set an existing absolute directory, identically mounted inside the worker and on the Docker host.
SCANNER_JOBS_DIR=
WORKER_UID=1000
DOCKER_GID=1000
DOCKER_SOCKET=/var/run/docker.sock
TASKS_EAGER=false
ALLOW_DEMO_LOGIN=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_CHECKS_ENABLED=false
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Next.js server-only environment variable (also set this in Vercel).
API_URL=http://127.0.0.1:8000
